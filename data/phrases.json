{
  "groups": [
    {
      "id": "restaurant",
      "title": "At Restaurants",
      "icon": "utensils",
      "phrases": [
        {
          "en": "One person",
          "jp": "一人です",
          "romaji": "hitori desu",
          "context": "Say this when entering — they'll seat you immediately"
        },
        {
          "en": "Counter seat please",
          "jp": "カウンター席お願いします",
          "romaji": "kauntā seki onegai shimasu"
        },
        {
          "en": "This one please [point at menu]",
          "jp": "これをお願いします",
          "romaji": "kore wo onegai shimasu"
        },
        {
          "en": "What do you recommend?",
          "jp": "おすすめは何ですか？",
          "romaji": "osusume wa nan desu ka?"
        },
        {
          "en": "Firm noodles please",
          "jp": "麺かためで",
          "romaji": "men katame de",
          "context": "Use at Hakata ramen shops — they'll ask noodle firmness"
        },
        {
          "en": "Extra noodles please (ramen refill)",
          "jp": "替え玉お願いします",
          "romaji": "kaedama onegai shimasu",
          "context": "Hakata ramen specialty — ~¥100–200 for another serving of noodles"
        },
        {
          "en": "Check please",
          "jp": "お会計お願いします",
          "romaji": "okaikei onegai shimasu"
        },
        {
          "en": "It's delicious!",
          "jp": "美味しいです！",
          "romaji": "oishii desu!",
          "context": "Chefs love hearing this — especially at counter seats"
        },
        {
          "en": "Thank you for the meal [when leaving]",
          "jp": "ごちそうさまでした",
          "romaji": "gochisōsama deshita",
          "context": "Say this when finished — shows appreciation"
        },
        {
          "en": "Water please",
          "jp": "水をください",
          "romaji": "mizu wo kudasai"
        }
      ]
    },
    {
